	uDesc.TextColor3 = Theme.Colors.Cream
	uDesc.TextSize = Theme.TextSizes.Small
	uDesc.TextXAlignment = Enum.TextXAlignment.Left
	uDesc.TextWrapped = true
	uDesc.Parent = upgradeCard
	self._homeUpgradeDesc = uDesc

	local actions = Composer.stack(scroll, "HomeActions")
	actions.LayoutOrder = 0
	self._homeContext = Composer.label(actions, "NextContext", "Loading next organic context...", 18, Theme.Colors.Amber)
	self._homeResult = Composer.label(actions, "LatestResult", "No confirmed posts yet.", 15)
	Composer.button(actions, "CreateOrganicShortcut", "Create organic post", function() self:SelectTab("Create") end)
	Composer.button(actions, "FeedShortcut", "View Buzzline", function() self:SelectTab("Feed") end)
	self._homeMissionAction = Composer.button(actions, "MissionShortcut", "View Missions", function() self:SelectTab("Missions") end)
	self._homePendingAction = Composer.button(actions, "PendingShortcut", "View pending post", function()
		local pendingPost = self._lastState and self._lastState.snapshot and self._lastState.snapshot.pendingPost
		self:SelectTab(if pendingPost and pendingPost.mode == "mission" then "Missions" else "Create")
	end)
	self._homeRefresh = Composer.button(actions, "RefreshProgress", "Refresh confirmed progress", function() self._onAction("GetSnapshot", {}) end)
	self._homeNotice = Composer.label(actions, "ConnectionNotice", "", 14, Theme.Colors.CreamMuted)
	for _, control in ipairs(actions:GetChildren()) do
		if control:IsA("TextButton") and control.Name ~= "CreateOrganicShortcut" then
			control.BackgroundColor3 = Theme.Colors.CharcoalLight
			control.TextColor3 = Theme.Colors.Cream
		end
	end

	return scroll
end

function Desktop:_createMetricBox(parent: Instance, tag: string, value: string, valColor: Color3, widthFraction: number): TextLabel
	local box = Instance.new("Frame")
	box.Name = `Box_{tag}`
	box.BackgroundColor3 = Theme.Colors.CharcoalDark
	box.Size = UDim2.new(widthFraction, -8, 1, 0)
	box.Parent = parent
	Theme.applyCorner(box, Theme.Radii.Medium)
	Theme.applyStroke(box, Theme.Colors.Border, 1)
	Theme.applyPadding(box, 10, 12, 10, 12)

	local tLabel = Instance.new("TextLabel")
	tLabel.Name = "Tag"
	tLabel.BackgroundTransparency = 1
	tLabel.Size = UDim2.new(1, 0, 0, 16)
	tLabel.Font = Theme.Fonts.Bold
	tLabel.Text = tag
	tLabel.TextColor3 = Theme.Colors.CreamMuted
	tLabel.TextSize = Theme.TextSizes.Tiny
	tLabel.TextXAlignment = Enum.TextXAlignment.Left
	tLabel.TextWrapped = true
	tLabel.Parent = box

	local tagSizeConstraint = Instance.new("UITextSizeConstraint")
	tagSizeConstraint.MinTextSize = 9
	tagSizeConstraint.MaxTextSize = 13
	tagSizeConstraint.Parent = tLabel

	local vLabel = Instance.new("TextLabel")
	vLabel.Name = "Val"
	vLabel.BackgroundTransparency = 1
	vLabel.Size = UDim2.new(1, 0, 1, -18)
	vLabel.Position = UDim2.new(0, 0, 0, 18)
	vLabel.Font = Theme.Fonts.Black
	vLabel.Text = value
	vLabel.TextColor3 = valColor
	vLabel.TextSize = Theme.TextSizes.Title
	vLabel.TextXAlignment = Enum.TextXAlignment.Left
	vLabel.Parent = box

	local textSizeConstraint = Instance.new("UITextSizeConstraint")
	textSizeConstraint.MinTextSize = 12
	textSizeConstraint.MaxTextSize = 22
	textSizeConstraint.Parent = vLabel

	if self._metricBoxes ~= nil then
		table.insert(self._metricBoxes, {
			box = box,
			tag = tLabel,
			val = vLabel,
		})
	end

	return vLabel
end

function Desktop:_createPlaceholderPage(title: string, description: string, badgeText: string): GuiObject
	local page = Instance.new("Frame")
	page.Name = `Page_{title}`
	page.BackgroundTransparency = 1
	page.Size = UDim2.new(1, 0, 1, 0)
	page.Visible = false
	page.Parent = self._contentArea

	Theme.applyPadding(page, 32, 32, 32, 32)

	local card = Instance.new("Frame")
	card.Name = "InfoCard"
	card.BackgroundColor3 = Theme.Colors.CharcoalDark
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Position = UDim2.new(0.5, 0, 0.45, 0)
	card.Size = UDim2.new(0.9, 0, 0, 240)
	card.Parent = page
	Theme.applyCorner(card, Theme.Radii.Large)
	Theme.applyStroke(card, Theme.Colors.Border, 1)
	Theme.applyPadding(card, 24, 24, 24, 24)

	local badge = Instance.new("TextLabel")
	badge.Name = "Badge"
	badge.BackgroundColor3 = Theme.Colors.CharcoalLight
	badge.Size = UDim2.new(0, 180, 0, 24)
	badge.Font = Theme.Fonts.Bold
	badge.Text = string.upper(badgeText)
	badge.TextColor3 = Theme.Colors.Amber
	badge.TextSize = Theme.TextSizes.Tiny
	badge.Parent = card
	Theme.applyCorner(badge, Theme.Radii.Pill)

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Position = UDim2.new(0, 0, 0, 36)
	titleLabel.Size = UDim2.new(1, 0, 0, 28)
	titleLabel.Font = Theme.Fonts.Black
	titleLabel.Text = title
	titleLabel.TextColor3 = Theme.Colors.Cream
	titleLabel.TextSize = Theme.TextSizes.Header
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = card

	local descLabel = Instance.new("TextLabel")
	descLabel.Name = "Description"
	descLabel.BackgroundTransparency = 1
	descLabel.Position = UDim2.new(0, 0, 0, 72)
	descLabel.Size = UDim2.new(1, 0, 0, 48)
	descLabel.Font = Theme.Fonts.Regular
	descLabel.Text = description
	descLabel.TextColor3 = Theme.Colors.CreamMuted
	descLabel.TextSize = Theme.TextSizes.Body
	descLabel.TextXAlignment = Enum.TextXAlignment.Left
	descLabel.TextWrapped = true
	descLabel.Parent = card

	local notice = Instance.new("TextLabel")
	notice.Name = "Notice"
	notice.BackgroundTransparency = 1
	notice.Position = UDim2.new(0, 0, 0, 136)
	notice.Size = UDim2.new(1, 0, 0, 40)
	notice.Font = Theme.Fonts.Medium
	notice.Text = "This screen's interactive workflows will be active in future milestones. No speculative currency or actions take place here."
	notice.TextColor3 = Theme.Colors.Sage
	notice.TextSize = Theme.TextSizes.Small
	notice.TextXAlignment = Enum.TextXAlignment.Left
	notice.TextWrapped = true
	notice.Parent = card

	return page
end

-- ==================== UPDATE & LIFECYCLE ====================

function Desktop:Update(stateData: any)
	self._lastState = stateData
	self._feed:Update(stateData)
	self._composer:Update(stateData)
	self._missions:Update(stateData)
	self._upgrades:Update(stateData)
	self._workers:Update(stateData)
	local snap = stateData.snapshot
	if snap == nil then
		return
	end

	-- Update Financials
	local balance = snap.balance or 0
	local pending = snap.pendingWorkerCuan or 0
	local rate = snap.incomePerSecond or 0
	local deviceId = snap.deviceId or "phone_cheap"

	self._homeCuanVal.Text = `{Theme.formatNumber(balance)} Cuan`
	self._homePendingVal.Text = `{Theme.formatNumber(pending)} Cuan`
	self._homeRateVal.Text = `+{string.format("%.1f", rate)}/s`

	-- Update Hardware Display (all copy derived from Catalog; never hardcoded
	-- numbers that can drift from the settled economy).
	local device = Upgrades.deviceById(deviceId)
	local deviceLabel = Presentation.Devices[deviceId] or deviceId
	if device ~= nil then
		local strong, weak = Upgrades.payoutOf(device)
		local nextDevice = nil
		for _, candidate in ipairs(Catalog.Devices) do
			if candidate.order == device.order + 1 and table.find(Catalog.Shipped.deviceIds, candidate.id) ~= nil then
				nextDevice = candidate
				break
			end
		end
		self._homeDeviceName.Text = `{deviceLabel} (Equipped)`
		self._homeDeviceNote.Text = string.format(
			"%.2fx yield · strong %d Cuan · weak %d Cuan · reveal %ds. " .. (if device.isPhone then "This phone produces your posts; the CRT is dashboard-only." else "PC Rumah produces your posts; the docked phone is cosmetic."),
			device.deviceYield,
			strong,
			weak,
			device.revealSeconds
		)
		if nextDevice ~= nil then
			local nextStrong = Upgrades.payoutOf(nextDevice)
			self._homeUpgradeDesc.Text = string.format(
				"%s (%d Cuan) — strong payout %d -> %d Cuan, reveal %ds -> %ds. Buy it in Upgrades.",
				Presentation.Devices[nextDevice.id] or nextDevice.id,
				nextDevice.price,
				strong,
				nextStrong,
				device.revealSeconds,
				nextDevice.revealSeconds
			)
		else
			self._homeUpgradeDesc.Text = "All shipped production hardware is equipped. Visit Workers to manage your first workstation."
		end
	else
		self._homeDeviceName.Text = "Unknown device"
		self._homeDeviceNote.Text = "Confirmed hardware could not be resolved from the catalog."
		self._homeUpgradeDesc.Text = "Open Upgrades to review available hardware."
	end

	local context = Presentation.Contexts[snap.nextOrganicContextId]
	self._homeContext.Text = if context then `Next organic post: {context.title}\n{context.trend} · {context.audience}` else "Waiting for next organic context"
	local latest = nil
	for _, post in ipairs(snap.ownPosts or {}) do
		if latest == nil or post.publishedAt > latest.publishedAt then latest = post end
	end
	self._homeResult.Text = if latest then `Latest confirmed result: {latest.finalImpact} impact · +{latest.organicCuan} organic Cuan` else "No confirmed posts yet. Start with an organic post."
	self._homePostSummary.Text = if snap.pendingPost then "Post resolving. You can browse, close, and return." else "Post slot available."
	self._homePendingAction.Visible = snap.pendingPost ~= nil
	local mission = snap.activeMission
	self._homeMissionAction.Text = if mission and mission.status == "readyToClaim" then "Claim ready mission · open campaign desk" elseif mission then "Resume mission" else "View Missions"
	self._homeMissionSummary.Text = if mission then `Campaign: {mission.status} · {mission.accumulatedImpact} confirmed impact` else "No active campaign. Visit Missions for a briefing."
	self._homeProgressTip.Text = if mission and mission.status == "readyToClaim" then "Your separate campaign bonus is ready to claim in Missions." else "Organic-only posts never advance campaign progress."
	self._homeNotice.Text = self._getBlockReason() or stateData.activeError or ""
end

function Desktop:Tick(serverNow: number)
	self._composer:Tick(serverNow)
	self._missions:Tick(serverNow)
end

function Desktop:SetVisible(visible: boolean, reducedMotion: boolean?)
	if self._gui.Enabled == visible then return end
	self._gui.Enabled = visible
	if visible then
		self._window.Size = UDim2.new(0.85, 0, 0.83, 0)
		self._backdrop.BackgroundTransparency = 1
		if reducedMotion then
			self._window.Size = UDim2.new(0.9, 0, 0.88, 0)
			self._backdrop.BackgroundTransparency = 0.45
		else
			Theme.tween(self._window, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(0.9, 0, 0.88, 0),
			})
			Theme.tween(self._backdrop, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 0.45,
			})
		end
	end
end

function Desktop:IsVisible(): boolean
	return self._gui.Enabled
end

function Desktop:Destroy()
	for _, c in ipairs(self._connections) do
		c:Disconnect()
	end
	self._gui:Destroy()
end

return Desktop
]]></ProtectedString>
