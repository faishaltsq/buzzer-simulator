		<Item class="ModuleScript" referent="101">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Buzzer Simulator — WorldService (BS-05).
-- Clones the reviewed Bedroom prefab per player, presents the equipped
-- productive phone, and validates the dashboard prompt.
--
-- Contract sources: docs/03 "World and interface ownership", docs/06
-- "World and Asset Plan", BS-05 in docs/08.
--
-- BOUNDARIES (strict):
--   * The old CRT is a BuzzerOS dashboard-access terminal ONLY. It is never a
--     productive device and carries no yield, multiplier or currency source.
--   * The server's confirmed `profile.deviceId` alone determines which phone
--     model is displayed. Terminal art never affects payout, impact or reveal.
--   * The dashboard prompt lives on the stable room-owned
--     `DashboardPromptAnchor`, never inside the replaceable CRT prefab.
--   * This service never charges currency and never mutates the economy.
--   * No RemoteEvents, no dashboard session lifecycle, no worker rigs. BS-06
--     performs runtime wiring and adds authoritative loaded-profile,
--     writable-session and lease checks on top of ValidateDashboardPrompt.
local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Catalog"))

local WorldService = {}

-- Stable room-owned anchor names (docs/03). These must exist in Bedroom.rbxmx.
local REQUIRED_ANCHORS = {
	"Spawn",
	"PlayerDesk",
	"DashboardPromptAnchor",
	"TerminalSlot",
	"PhoneSlot",
	"WorkerDeskSlot1",
	"WorkerSeat1",
	"WorkerDeskSlot2",
	"WorkerSeat2",
	"CameraFocus",
	"Door",
	"LightGroup",
}

-- Prefab names under ServerStorage.WorldPrefabs.
local PREFAB_BEDROOM = "Bedroom"
local PREFAB_CRT = "OldCRT"
local PREFAB_PHONE_CHEAP = "PhoneCheap"
local PREFAB_PHONE_FAST = "PhoneFast"
local PREFAB_PC_RUMAH = "PCRumah"
local PREFAB_WORKER_DESK_1 = "WorkerDesk1"
local PREFAB_TRAINEE_1 = "Trainee1"
-- The productive phone model shown for each equipped device. The CRT is
-- deliberately absent: it is dashboard-only and never a productive device.
local PHONE_PREFAB_BY_DEVICE: { [string]: string } = {
	phone_cheap = PREFAB_PHONE_CHEAP,
	phone_fast = PREFAB_PHONE_FAST,
}

local function isShippedDevice(deviceId: string): boolean
	local shipped = Catalog.Shipped or Catalog.V0Shipped
	return table.find(shipped.deviceIds, deviceId) ~= nil
end

-- docs/03: the player must be within 12 studs of the prompt.
local MAX_PROMPT_DISTANCE = 12

-- Root folder name for a player's cloned world.
local function worldFolderName(userId: number): string
	return `BuzzerRoom_{userId}`
end

-- Visual placement transforms for world models relative to their slot anchors.
-- Each model is placed upright resting on the desk surface (Y = 3.35) and
-- rotated 180 degrees around Y so the screen faces the player (+Z in room space).
local PLACEMENT_CONFIG = {
	OldCRT = {
		yOffset = 1.4, -- half-height of OldCRT (2.8 studs tall)
		rotation = CFrame.Angles(0, math.pi, 0),
	},
	PhoneCheap = {
		yOffset = 1.0, -- half-height of PhoneCheap (2.0 studs tall)
		rotation = CFrame.Angles(0, math.pi, 0),
	},
	PhoneFast = {
		yOffset = 1.1, -- half-height of PhoneFast (2.2 studs tall)
		rotation = CFrame.Angles(0, math.pi, 0),
	},
	PCRumah = {
		yOffset = 0.5, -- center of MonitorStand
		rotation = CFrame.Angles(0, math.pi, 0),
	},
	WorkerDesk1 = {
		yOffset = 0,
		rotation = CFrame.identity,
	},
	WorkerDesk2 = {
		yOffset = 0,
		rotation = CFrame.identity,
	},
	Trainee1 = {
		yOffset = 0,
		rotation = CFrame.identity,
	},
	Trainee2 = {
		yOffset = 0,
		rotation = CFrame.identity,
	},
}

-- Pivot a Model to a target CFrame relative to an anchor BasePart.
local function placeModel(model: Instance, anchor: BasePart, config: { yOffset: number, rotation: any })
	local basePosition: any = anchor.Position
	local targetPosition = Vector3.new(basePosition.X, basePosition.Y + config.yOffset, basePosition.Z)
	local targetCFrame = CFrame.new(targetPosition) * config.rotation
	local m: any = model
	m:PivotTo(targetCFrame)
end

-- Resolve the WorldPrefabs folder. Resolved lazily so the module loads under
-- both the production and test Rojo layouts.
local function prefabsFolder(): Folder?
	local storage = ServerStorage:FindFirstChild("WorldPrefabs")
	if storage ~= nil and storage:IsA("Folder") then
		return storage
	end
	return nil
end

local function findPrefab(name: string): Instance?
	local folder = prefabsFolder()
	if folder == nil then
		return nil
	end
	return folder:FindFirstChild(name)
end

-- True when a value is a nonempty string.
local function isNonEmptyString(v: any): boolean
	return typeof(v) == "string" and #v > 0
end

-- Recursively collect descendants by class, without yielding.
local function collectByClass(root: Instance, className: string): { Instance }
	local out: { Instance } = {}
	local stack: { Instance } = { root }
	while #stack > 0 do
		local node = table.remove(stack) :: any
		for _, child in ipairs(node:GetChildren()) do
			if child:IsA(className) then
				table.insert(out, child)
			end
			table.insert(stack, child)
		end
	end
	return out
end

-- Find a named descendant, without yielding.
local function findNamedDescendant(root: Instance, name: string): Instance?
	local stack: { Instance } = { root }
	while #stack > 0 do
		local node = table.remove(stack) :: any
		for _, child in ipairs(node:GetChildren()) do
			if child.Name == name then
				return child
			end
			table.insert(stack, child)
		end
	end
	return nil
end

-- ===== Spawn =====
-- Clone the reviewed Bedroom prefab into a player-owned Workspace folder,
-- place one OldCRT at TerminalSlot, and present the equipped phone at
-- PhoneSlot. Idempotent: an existing room is reused rather than duplicated.
function WorldService.Spawn(player: Player, profile: any): (boolean, string?)
	if not isNonEmptyString(player.Name) then
		return false, "player is required"
	end
	local bedroom = findPrefab(PREFAB_BEDROOM)
	if bedroom == nil then
		-- A missing prefab is a recoverable error: surface it, never strand the
		-- player in an empty room.
		return false, `prefab {PREFAB_BEDROOM} is missing from ServerStorage.WorldPrefabs`
	end

	-- Prevent duplicate world instances.
	local existing = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if existing ~= nil then
		-- Already spawned: resynchronise the device from confirmed state.
		local deviceId = if typeof(profile) == "table" then profile.deviceId else nil
		if isNonEmptyString(deviceId) then
			local synced, detail = WorldService.SyncDevice(player, deviceId)
			if not synced then return false, detail end
		end
		return WorldService.SyncWorkers(player, if typeof(profile) == "table" then profile.ownedDesks else nil, if typeof(profile) == "table" then profile.workers else nil)
	end

	local folder = Instance.new("Folder")
	folder.Name = worldFolderName(player.UserId)
	folder.Parent = Workspace

	local room = bedroom:Clone()
	room.Name = "Room"
	room.Parent = folder

	-- Verify every required anchor exists before wiring anything.
	for _, anchorName in ipairs(REQUIRED_ANCHORS) do
		if findNamedDescendant(room, anchorName) == nil then
			folder:Destroy()
			return false, `prefab {PREFAB_BEDROOM} is missing the {anchorName} anchor`
		end
	end

	-- Place terminal at TerminalSlot: PCRumah if profile owns pc_rumah and it is shipped, otherwise OldCRT.
	local deviceId = if typeof(profile) == "table" then profile.deviceId else nil
	local terminalSlot = findNamedDescendant(room, "TerminalSlot")
	local terminalPrefabName = if deviceId == "pc_rumah" and isShippedDevice("pc_rumah") then PREFAB_PC_RUMAH else PREFAB_CRT
	local terminalPrefab = findPrefab(terminalPrefabName)
	if terminalSlot == nil or terminalPrefab == nil then
		folder:Destroy()
		return false, `prefab {terminalPrefabName} is missing or TerminalSlot is absent`
	end
	local terminalInstance = terminalPrefab:Clone()
	terminalInstance.Name = terminalPrefabName
	terminalInstance.Parent = terminalSlot
	placeModel(terminalInstance, terminalSlot :: BasePart, (PLACEMENT_CONFIG :: any)[terminalPrefabName])

	-- Ensure the stable DashboardPromptAnchor carries exactly one ProximityPrompt.
	local promptAnchor = findNamedDescendant(room, "DashboardPromptAnchor")
	if promptAnchor ~= nil and promptAnchor:FindFirstChildOfClass("ProximityPrompt") == nil then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "DashboardPrompt"
		prompt.ActionText = "Open BuzzerOS"
		prompt.ObjectText = "BuzzerOS Terminal"
		prompt.MaxActivationDistance = 10
		prompt.HoldDuration = 0
		prompt.RequiresLineOfSight = false
		prompt.Parent = promptAnchor
	end
	-- Present the equipped phone from the confirmed profile.
	local deviceId = if typeof(profile) == "table" then profile.deviceId else nil
	if isNonEmptyString(deviceId) then
		local okPhone, errPhone = WorldService.SyncDevice(player, deviceId)
		if not okPhone then
			folder:Destroy()
			return false, errPhone
		end
	end

	-- Present workstation desks and trainees from confirmed profile.
	local ownedDesks = if typeof(profile) == "table" then profile.ownedDesks else nil
	local workers = if typeof(profile) == "table" then profile.workers else nil
	local okWorkers, errWorkers = WorldService.SyncWorkers(player, ownedDesks, workers)
	if not okWorkers then
		folder:Destroy()
		return false, errWorkers
	end

	return true, nil
end

-- ===== SyncDevice =====
-- Present the phone model for the confirmed deviceId at PhoneSlot. Idempotent:
-- repeated calls with the same device replace rather than stack, so a rejoin or
-- a re-sync never leaves two phones or a stale model.
function WorldService.SyncDevice(player: Player, deviceId: string): (boolean, string?)
	if not isNonEmptyString(deviceId) then
		return false, "deviceId is required"
	end
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return false, "player has no spawned room; call Spawn first"
	end

	if deviceId == "pc_rumah" then
		if not isShippedDevice("pc_rumah") then
			return false, `no V0 phone presentation for device {deviceId}`
		end
		local terminalSlot = findNamedDescendant(folder, "TerminalSlot")
		if terminalSlot == nil then
			return false, "TerminalSlot anchor is missing from the room"
		end
		local pcPrefab = findPrefab(PREFAB_PC_RUMAH)
		if pcPrefab == nil then
			return false, `prefab {PREFAB_PC_RUMAH} is missing from ServerStorage.WorldPrefabs`
		end
		for _, child: any in ipairs(terminalSlot:GetChildren()) do
			child:Destroy()
		end
		local pcInstance = pcPrefab:Clone()
		pcInstance.Name = PREFAB_PC_RUMAH
		pcInstance.Parent = terminalSlot
		placeModel(pcInstance, terminalSlot :: BasePart, PLACEMENT_CONFIG.PCRumah)

		-- Ensure PhoneSlot retains an inert owned phone prop (PhoneFast) if empty.
		local phoneSlot = findNamedDescendant(folder, "PhoneSlot")
		if phoneSlot ~= nil and #phoneSlot:GetChildren() == 0 then
			local fastPrefab = findPrefab(PREFAB_PHONE_FAST)
			if fastPrefab ~= nil then
				local phone = fastPrefab:Clone()
				phone.Name = PREFAB_PHONE_FAST
				phone.Parent = phoneSlot
				placeModel(phone, phoneSlot :: BasePart, PLACEMENT_CONFIG.PhoneFast)
			end
		end
		return true, nil
	end

	local prefabName = PHONE_PREFAB_BY_DEVICE[deviceId]
	if prefabName == nil then
		return false, `no V0 phone presentation for device {deviceId}`
	end
	local phoneSlot = findNamedDescendant(folder, "PhoneSlot")
	if phoneSlot == nil then
		return false, "PhoneSlot anchor is missing from the room"
	end
	local prefab = findPrefab(prefabName)
	if prefab == nil then
		return false, `prefab {prefabName} is missing from ServerStorage.WorldPrefabs`
	end

	-- If terminal slot holds PCRumah and device is a phone, restore OldCRT
	local terminalSlot = findNamedDescendant(folder, "TerminalSlot")
	if terminalSlot ~= nil and terminalSlot:FindFirstChild(PREFAB_PC_RUMAH) ~= nil then
		for _, child: any in ipairs(terminalSlot:GetChildren()) do
			child:Destroy()
		end
		local crt = findPrefab(PREFAB_CRT)
		if crt ~= nil then
			local crtInstance = crt:Clone()
			crtInstance.Name = PREFAB_CRT
			crtInstance.Parent = terminalSlot
			placeModel(crtInstance, terminalSlot :: BasePart, PLACEMENT_CONFIG.OldCRT)
		end
	end

	-- Remove any previously presented phone so the slot never holds two models.
	for _, child: any in ipairs(phoneSlot:GetChildren()) do
		child:Destroy()
	end

	local phone = prefab:Clone()
	phone.Name = prefabName
	phone.Parent = phoneSlot
	local config = PLACEMENT_CONFIG[prefabName]
	if config ~= nil then
		placeModel(phone, phoneSlot :: BasePart, config)
	end
	return true, nil
end

-- ===== SyncWorkers =====
-- Present workstation desks and trainee rigs from confirmed profile state.
-- Idempotent: existing instances are preserved, missing instances are mounted,
-- and revoked/unowned instances are destroyed cleanly without leaking parts.
function WorldService.SyncWorkers(player: Player, ownedDesks: { number }?, workers: { any }?): (boolean, string?)
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return false, "player has no spawned room; call Spawn first"
	end

	local desksList = ownedDesks or {}
	local workersList = workers or {}

	for slot = 1, 2 do
		local deskSlot = findNamedDescendant(folder, `WorkerDeskSlot{slot}`)
		local deskPrefabName = if slot == 1 then PREFAB_WORKER_DESK_1 else `WorkerDesk{slot}`
		if deskSlot ~= nil then
			local ownsDesk = table.find(desksList, slot) ~= nil
			local existingDesk = deskSlot:FindFirstChild(deskPrefabName)
			if ownsDesk then
				if existingDesk == nil then
					local prefab = findPrefab(deskPrefabName)
					if prefab == nil then
						return false, `prefab {deskPrefabName} is missing from ServerStorage.WorldPrefabs`
					end
					for _, child in ipairs(deskSlot:GetChildren()) do
						child:Destroy()
					end
					local desk = prefab:Clone()
					desk.Name = deskPrefabName
					desk.Parent = deskSlot
					local cfg = (PLACEMENT_CONFIG :: any)[deskPrefabName] or { yOffset = 0, rotation = CFrame.identity }
					placeModel(desk, deskSlot :: BasePart, cfg)
				end
			else
				if existingDesk ~= nil then
					for _, child in ipairs(deskSlot:GetChildren()) do
						child:Destroy()
					end
				end
			end
		end

		local seatSlot = findNamedDescendant(folder, `WorkerSeat{slot}`)
		local traineePrefabName = if slot == 1 then PREFAB_TRAINEE_1 else `Trainee{slot}`
		if seatSlot ~= nil then
			local hasWorker = false
			for _, w in ipairs(workersList) do
				if (w :: any).slotIndex == slot then
					hasWorker = true
					break
				end
			end
			local existingTrainee = seatSlot:FindFirstChild(traineePrefabName)
			if hasWorker then
				if existingTrainee == nil then
					local prefab = findPrefab(traineePrefabName)
					if prefab == nil then
						return false, `prefab {traineePrefabName} is missing from ServerStorage.WorldPrefabs`
					end
					for _, child in ipairs(seatSlot:GetChildren()) do
						child:Destroy()
					end
					local trainee = Instance.new("Folder")
					trainee.Name = traineePrefabName
					trainee:SetAttribute("WorkerCosmetic", true)
					trainee.Parent = seatSlot
				end
			else
				if existingTrainee ~= nil then
					for _, child in ipairs(seatSlot:GetChildren()) do
						child:Destroy()
					end
				end
			end
		end
	end

	return true, nil
end
-- ===== ValidateDashboardPrompt =====
-- Validate the exact player-owned prompt, a living character, and a maximum
-- 12-stud distance. Accepts either the ProximityPrompt instance or its anchor
-- BasePart. Distance is always measured authoritatively from the anchor Part.
-- BS-06 additionally enforces authoritative loaded-profile, writable-session
-- and lease checks; this function deliberately does not.
function WorldService.ValidateDashboardPrompt(player: Player, prompt: Instance): (boolean, string?)
	if prompt == nil then
		return false, "prompt is required"
	end
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return false, "player has no spawned room"
	end
	-- The prompt must belong to THIS player's room.
	if not prompt:IsDescendantOf(folder) then
		return false, "prompt does not belong to this player's room"
	end

	-- Resolve the anchor Part and the server-owned ProximityPrompt.
	local anchorCandidate = findNamedDescendant(folder, "DashboardPromptAnchor")
	if anchorCandidate == nil or not anchorCandidate:IsA("BasePart") then
		return false, "DashboardPromptAnchor is missing from the room"
	end
	local anchorPart = anchorCandidate :: BasePart
	local serverPrompt = anchorPart:FindFirstChildOfClass("ProximityPrompt")

	-- Validate prompt identity against server-owned instances.
	if prompt:IsA("ProximityPrompt") then
		if serverPrompt == nil or prompt ~= serverPrompt then
			return false, "prompt is not the server-owned DashboardPrompt"
		end
	elseif prompt:IsA("BasePart") then
		if prompt ~= anchorPart then
			return false, "prompt is not the stable DashboardPromptAnchor"
		end
	else
		return false, "prompt must be a ProximityPrompt or BasePart"
	end
	-- The player must have a living character.
	local character = player.Character
	if character == nil then
		return false, "player has no character"
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return false, "player character is not alive"
	end
	local health = humanoid.Health
	if typeof(health) ~= "number" or health <= 0 then
		return false, "player character is not alive"
	end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart == nil or not rootPart:IsA("BasePart") then
		return false, "player character has no root part"
	end

	-- Within 12 studs measured from the anchor Part to HumanoidRootPart.
	local distance = ((rootPart :: any).Position - anchorPart.Position).Magnitude
	if distance > MAX_PROMPT_DISTANCE then
		return false, `player is {math.floor(distance)} studs away; the limit is {MAX_PROMPT_DISTANCE}`
	end
	return true, nil
end
-- ===== Remove =====
-- Clean up the player's owned world instances. Idempotent.
function WorldService.Remove(player: Player): (boolean, string?)
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return true, nil
	end
	folder:Destroy()
	return true, nil
end

-- ===== introspection (specs and BS-06 wiring) =====
function WorldService.GetRoom(player: Player): Instance?
	return Workspace:FindFirstChild(worldFolderName(player.UserId))
end

function WorldService.GetAnchor(player: Player, anchorName: string): Instance?
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return nil
	end
	return findNamedDescendant(folder, anchorName)
end

-- ===== GetPrompt =====
-- Retrieve the server-owned ProximityPrompt instance from the player's room.
function WorldService.GetPrompt(player: Player): ProximityPrompt?
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return nil
	end
	local anchor = findNamedDescendant(folder, "DashboardPromptAnchor")
	if anchor == nil then
		return nil
	end
	return (anchor:FindFirstChildOfClass("ProximityPrompt") :: any)
end

-- Count instances of a class inside the player's room.
function WorldService.CountInRoom(player: Player, className: string): number
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return 0
	end
	return #collectByClass(folder, className)
end

-- True when the room contains any Script, LocalScript or ModuleScript. Used by
-- specs to prove no untrusted code rides along inside an exported prefab.
function WorldService.HasScripts(player: Player): boolean
	local folder = Workspace:FindFirstChild(worldFolderName(player.UserId))
	if folder == nil then
		return false
	end
	for _, className in ipairs({ "Script", "LocalScript", "ModuleScript" }) do
		if #collectByClass(folder, className) > 0 then
			return true
		end
	end
	return false
end

WorldService.REQUIRED_ANCHORS = REQUIRED_ANCHORS
WorldService.MAX_PROMPT_DISTANCE = MAX_PROMPT_DISTANCE
WorldService.PHONE_PREFAB_BY_DEVICE = PHONE_PREFAB_BY_DEVICE
WorldService.PREFAB_BEDROOM = PREFAB_BEDROOM
WorldService.PREFAB_CRT = PREFAB_CRT
WorldService.PREFAB_PHONE_CHEAP = PREFAB_PHONE_CHEAP
WorldService.PREFAB_PHONE_FAST = PREFAB_PHONE_FAST
WorldService.PREFAB_WORKER_DESK_1 = PREFAB_WORKER_DESK_1
WorldService.PREFAB_TRAINEE_1 = PREFAB_TRAINEE_1
WorldService.SyncWorkers = WorldService.SyncWorkers

return WorldService
]]></ProtectedString>
