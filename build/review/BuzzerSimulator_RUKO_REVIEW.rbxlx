		<Item class="ModuleScript" referent="93">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Buzzer Simulator — MissionService (BS-03, pure domain layer).
-- One shared post/settlement path for organic and mission-tagged posts.
--
-- BOUNDARY (docs/03, BS-03 backlog): this module owns pure gameplay-state
-- transformations ONLY. It never persists, never touches the network, never
-- mutates its input profile, and never awards anything before a durable write
-- confirms it. Every operation returns an explicit code plus a PROPOSED
-- profile; SessionService (BS-04) performs the conditional write and only then
-- publishes the state. A failed or uncertain save therefore cannot expose
-- unconfirmed balance or mission progress.
--
-- Determinism: no randomness anywhere. Outcomes are frozen at publish and
-- settlement consumes the frozen values, so a rejoin replays exactly.
local Catalog = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Catalog"))
local Rules = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Rules"))
-- Sibling server module. Resolved through the service tree rather than
-- script.Parent so the module works under both Rojo layouts: production maps
-- it beside MissionService in ServerScriptService, while the test project maps
-- it to ServerStorage so specs can require it without auto-running it.
--
-- The lookup is deferred to first use (not at require time) so the module loads
-- under either layout and under test harnesses that install globals later.
local ScoringCatalog: any = nil
local function scoringCatalog(): any
	if ScoringCatalog ~= nil then
		return ScoringCatalog
	end
	local services = { "ServerScriptService", "ServerStorage" }
	for _, serviceName in ipairs(services) do
		local service = game:GetService(serviceName)
		local found = service:FindFirstChild("ScoringCatalog")
		if found ~= nil then
			ScoringCatalog = require(found)
			return ScoringCatalog
		end
	end
	error("MissionService: ScoringCatalog module not found", 0)
end

local MissionService = {}

-- Bounds from the frozen v1 profile contract (docs/03).
local MAX_OWN_POSTS = 10
local MAX_CLAIMED_RUNS = 32
local MAX_CAMPAIGN_POSTS = 2
-- Frozen economy guard (docs/04): "stop growth before 1e12". A credit that
-- would bring either currency total to or past this bound is refused outright
-- rather than clamped, so no payout formula is altered and no partial
-- mutation can land. ProfileStore repeats the check as defense in depth.
local MAX_ECONOMIC_TOTAL = 1e12

-- PostMode and FitKind are declared locally to match the frozen GameTypes
-- unions ("organic" | "mission", "strong" | "weak") without a runtime
-- dependency on the shared module.
export type PostMode = "organic" | "mission"
export type FitKind = "strong" | "weak"

export type ResultCode =
	"OK"
	| "INVALID_INPUT"
	| "NOT_READY"
	| "ALREADY_DONE"
	| "LIMIT_REACHED"
	| "UNKNOWN_MISSION"
	| "UNKNOWN_TEMPLATE"
	| "UNKNOWN_CONTEXT"
	| "NO_ACTIVE_MISSION"
	| "MISSION_ACTIVE"
	| "PENDING_POST"
	| "NOT_DUE"
	| "NO_PENDING_POST"
	| "RUN_MISMATCH"
	| "INVALID_CONTENT"

export type OperationResult = {
	ok: boolean,
	code: ResultCode,
	detail: string?,
	profile: any?, -- proposed updated profile when ok
}

local function ok(profile: any): OperationResult
	return { ok = true, code = "OK", profile = profile }
end
local function fail(code: ResultCode, detail: string?): OperationResult
	return { ok = false, code = code, detail = detail }
end

-- ===== helpers =====
-- Deep copy so the caller's profile is never mutated, in place or by aliasing.
local function deepCopy(value: any): any
	if typeof(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value) do
		copy[deepCopy(k)] = deepCopy(v)
	end
	return copy
end
MissionService._deepCopy = deepCopy

local function isNonEmptyString(v: any): boolean
	return typeof(v) == "string" and #v > 0
end

-- Server time is injected by the caller (BS-04 supplies it). Only a finite,
-- nonnegative number is a valid server timestamp: NaN and both infinities are
-- rejected (Rules validates its numeric inputs the same way, src/shared/Rules),
-- and a negative timestamp cannot describe a published or settled post. A
-- non-finite `now` would otherwise produce a pending post with an infinite
-- settleAt that ProfileStore rejects far from its cause.
local function isValidServerTime(v: any): boolean
	return typeof(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge and v >= 0
end

local function findMission(missionId: any): any?
	if not isNonEmptyString(missionId) then
		return nil
	end
	for _, mission in ipairs(Catalog.Missions) do
		if (mission :: any).missionId == missionId then
			return mission
		end
	end
	return nil
end

-- Shipped-content gate.
local function getShipped()
	return Catalog.Shipped or Catalog.V0Shipped
end

local function isShippedMission(missionId: string): boolean
	for _, id in ipairs(getShipped().missionIds) do
		if id == missionId then
			return true
		end
	end
	return false
end

local function isShippedOrganicContext(contextId: string): boolean
	for _, id in ipairs(getShipped().organicContextIds) do
		if id == contextId then
			return true
		end
	end
	return false
end

-- The equipped device's yield and reveal window. Posting always reads the ONE
-- productive profile.deviceId, never a terminal or client-supplied value
-- (docs/03).
local function deviceFor(profile: any): (number?, number?, string?)
	for _, device in ipairs(Catalog.Devices) do
		if (device :: any).id == profile.deviceId then
			return (device :: any).deviceYield, (device :: any).revealSeconds, nil
		end
	end
	return nil, nil, `unknown device {tostring(profile.deviceId)}`
end

-- Organic contexts available to this profile: only shipped ones, in catalog
-- order. V0 has exactly one, so the sequence is constant until BS-11.
local function shippedOrganicContexts(): { any }
	local out: { any } = {}
	for _, ctx in ipairs(Catalog.OrganicContexts) do
		if isShippedOrganicContext((ctx :: any).contextId) then
			table.insert(out, ctx)
		end
	end
	return out
end

-- Contexts available to a mission: only the ones the public Catalog lists for
-- it AND that are shipped. Rotation is `counter % #contexts`.
local function missionContexts(mission: any): { string }
	local out: { string } = {}
	for _, contextId in ipairs(mission.contexts) do
		table.insert(out, contextId)
	end
	return out
end

local function nextOrganicContext(profile: any): (any?, string?)
	local contexts = shippedOrganicContexts()
	if #contexts == 0 then
		return nil, "no shipped organic contexts"
	end
	local index = (profile.nextOrganicSequence % #contexts) + 1
	return contexts[index], nil
end

-- Freeze a pending post. The outcome is computed ONCE here and never recomputed
-- (docs/03: "compute and freeze final outcome on the server at publish").
-- `requiredImpact` is the B the post is scored against. Organic-only posts use
-- B=100 for presentation (docs/03); mission-tagged posts use the mission's own
-- requiredImpact, so a harder mission genuinely needs a stronger post.
local function buildPendingPost(
	profile: any,
	mode: PostMode,
	contextId: string,
	templateId: string,
	fit: FitKind,
	deviceYield: number,
	revealSeconds: number,
	now: number,
	missionRunId: string?,
	requiredImpact: number
): any
	local finalImpact = Rules.postImpact(requiredImpact, fit, deviceYield)
	local organicCuan = Rules.organicCuan(fit, deviceYield)
	local postId = `post-{profile.nextPostSequence}`
	return {
		postId = postId,
		mode = mode,
		missionRunId = missionRunId,
		contextId = contextId,
		templateId = templateId,
		publishedAt = now,
		settleAt = now + revealSeconds,
		finalImpact = finalImpact,
		organicCuan = organicCuan,
	}
end

-- A mission's own contexts are shipped with the mission itself; V0 ships one
-- mission with one context, so this is true for every catalogued mission
-- context. Kept as a named check so BS-11 can gate M1 contexts explicitly.
local function isMissionContextShipped(mission: any, contextId: string): boolean
	for _, id in ipairs((mission :: any).contexts) do
		if id == contextId then
			return true
		end
	end
	return false
end
MissionService._isMissionContextShipped = isMissionContextShipped

-- Mission-context tags come from ScoringCatalog's explicit server-owned
-- mapping. MissionDef in the public Catalog carries no trendId/audienceId, so
-- there is nothing to inherit and no default to fall back to: an unknown
-- context is a hard error, which keeps M1 content from silently scoring
-- against V0 tags.
local function missionContextTags(contextId: any): (string?, string?, string?)
	return scoringCatalog().missionContextTags(contextId)
end
MissionService._missionContextTags = missionContextTags

-- ===== AcceptMission =====
-- Validate against shipped catalog content and progression, require no active
-- mission, freeze the rotated context and the assigned run ID, and increment
-- the variant counter ONLY in the proposed state.
function MissionService.accept(profile: any, missionId: string, runId: string, now: number): OperationResult
	if not isNonEmptyString(missionId) or not isNonEmptyString(runId) then
		return fail("INVALID_INPUT", "missionId and runId are required")
	end
	if not isValidServerTime(now) then
		return fail("INVALID_INPUT", "now must be a finite nonnegative number")
	end
	if profile.activeMission ~= nil then
		return fail("MISSION_ACTIVE", "a mission is already active")
	end
	-- docs/02: "Accepting a mission while browsing or making organic posts is
	-- allowed." Accepting does not touch the single global pending-post slot, so
	-- an in-flight ORGANIC post must not block it. A mission-tagged post in
	-- flight does block it, because that post belongs to a run and accepting a
	-- new mission would orphan it.
	if profile.pendingPost ~= nil and profile.pendingPost.mode == "mission" then
		return fail("PENDING_POST", "a mission post is already resolving")
	end
	local mission = findMission(missionId)
	if mission == nil then
		return fail("UNKNOWN_MISSION", `unknown mission {missionId}`)
	end
	if not isShippedMission(missionId) then
		return fail("NOT_READY", `mission {missionId} is not shipped in V0`)
	end
	-- Progression gates from the catalog definition.
	if profile.completedMissions < mission.unlockClaims then
		return fail("NOT_READY", `mission {missionId} requires {mission.unlockClaims} prior claims`)
	end
	-- Tier gate from the catalog definition. The v1 profile persists no tier
	-- field, so eligibility is derived from the monotone inputs (docs/02 career
	-- table: tier requires BOTH lifetime earnings and completed claims) and
	-- clamped to the currently shipped tier cap. Spending never demotes, so the
	-- derivation is stable across a rejoin. V0's food_stall_launch has
	-- minTier = 0 and stays available at tier 0.
	local eligibleTier = Rules.eligibleTier(
		profile.lifetimeEarned,
		profile.completedMissions,
		getShipped().maxShippedTier
	)
	if eligibleTier < (mission :: any).minTier then
		return fail(
			"NOT_READY",
			`mission {missionId} requires tier {(mission :: any).minTier}; eligible tier is {eligibleTier}`
		)
	end
	local contexts = missionContexts(mission)
	if #contexts == 0 then
		return fail("INVALID_CONTENT", `mission {missionId} has no contexts`)
	end
	-- Rotation from the SAVED counter, never rerolled on reopen or rejoin.
	local counter = profile.missionVariantCounters[missionId] or 0
	local index = (counter % #contexts) + 1
	local contextId = contexts[index]
	if not isShippedOrganicContext(contextId) and not isMissionContextShipped(mission, contextId) then
		return fail("NOT_READY", `context {contextId} is not shipped in V0`)
	end

	local next = deepCopy(profile)
	next.activeMission = {
		missionId = missionId,
		runId = runId,
		contextId = contextId,
		status = "accepted",
		accumulatedImpact = 0,
		postCount = 0,
	}
	-- The counter advances only in the successful proposed state.
	next.missionVariantCounters = deepCopy(profile.missionVariantCounters)
	next.missionVariantCounters[missionId] = counter + 1
	return ok(next)
end


-- ===== PublishOrganic =====
-- No mission required. Selects the next organic context from the saved
-- sequence, validates the template, freezes the outcome, and advances the
-- sequence only in the proposed state. Awards nothing at publish.
function MissionService.publishOrganic(profile: any, templateId: string, now: number): OperationResult
	if not isNonEmptyString(templateId) then
		return fail("INVALID_INPUT", "templateId is required")
	end
	if not isValidServerTime(now) then
		return fail("INVALID_INPUT", "now must be a finite nonnegative number")
	end
	if profile.pendingPost ~= nil then
		return fail("PENDING_POST", "a post is already resolving")
	end
	local context, ctxErr = nextOrganicContext(profile)
	if context == nil then
		return fail("UNKNOWN_CONTEXT", ctxErr)
	end
	local affinities = scoringCatalog().organicAffinities()[context.contextId]
	if affinities == nil then
		return fail("INVALID_CONTENT", `context {context.contextId} has no authored affinities`)
	end
	local fit, fitErr = scoringCatalog().fitForTemplate(
		templateId,
		context.templates,
		affinities,
		context.trendId,
		context.audienceId
	)
	if fit == nil then
		return fail("UNKNOWN_TEMPLATE", fitErr)
	end
	local deviceYield, revealSeconds, devErr = deviceFor(profile)
	if deviceYield == nil then
		return fail("INVALID_INPUT", devErr)
	end

	local next = deepCopy(profile)
	next.pendingPost = buildPendingPost(
		profile,
		"organic",
		context.contextId,
		templateId,
		fit,
		deviceYield,
		revealSeconds :: number,
		now,
		nil,
		-- Organic-only posts use B=100 for presentation (docs/03).
		100
	)
	next.nextPostSequence = profile.nextPostSequence + 1
	-- The organic sequence advances only on a successful publish.
	next.nextOrganicSequence = profile.nextOrganicSequence + 1
	return ok(next)
end

-- ===== PublishPost (mission-tagged) =====
-- Requires an active eligible mission and a matching run ID. Uses exactly the
-- same scoring, payout and settlement behaviour as organic posting, through the
-- one shared pending-post slot. Capped at two published posts per run.
function MissionService.publishMission(
	profile: any,
	runId: string,
	templateId: string,
	now: number
): OperationResult
	if not isNonEmptyString(runId) or not isNonEmptyString(templateId) then
		return fail("INVALID_INPUT", "runId and templateId are required")
	end
	if not isValidServerTime(now) then
		return fail("INVALID_INPUT", "now must be a finite nonnegative number")
	end
	if profile.pendingPost ~= nil then
		return fail("PENDING_POST", "a post is already resolving")
	end
	local mission = profile.activeMission
	if mission == nil then
		return fail("NO_ACTIVE_MISSION", "no active mission")
	end
	if mission.runId ~= runId then
		return fail("RUN_MISMATCH", "runId does not match the active mission")
	end
	-- The frozen cap: PublishPost admits while postCount < 2 (docs/03). Checked
	-- before the status so a third post reports the specific LIMIT_REACHED
	-- rather than a generic NOT_READY.
	if mission.postCount >= MAX_CAMPAIGN_POSTS then
		return fail("LIMIT_REACHED", "a mission run allows at most two campaign posts")
	end
	if mission.status ~= "accepted" and mission.status ~= "resolvingPost" then
		return fail("NOT_READY", `mission is {mission.status}`)
	end
	local missionDef = findMission(mission.missionId)
	if missionDef == nil then
		return fail("UNKNOWN_MISSION", `unknown mission {mission.missionId}`)
	end
	-- The template must belong to the mission's FROZEN context.
	local contextId = mission.contextId
	-- Resolve the tags first: an unknown context is the more specific and more
	-- actionable failure, and it must never fall back to V0 tags.
	local trendId, audienceId, tagErr = missionContextTags(contextId)
	if trendId == nil then
		return fail("UNKNOWN_CONTEXT", tagErr)
	end
	local affinities = scoringCatalog().missionAffinities()[contextId]
	if affinities == nil then
		return fail("INVALID_CONTENT", `context {contextId} has no authored affinities`)
	end
	local fit, fitErr = scoringCatalog().fitForTemplate(
		templateId,
		missionDef.templates,
		affinities,
		trendId,
		audienceId
	)
	if fit == nil then
		return fail("UNKNOWN_TEMPLATE", fitErr)
	end
	local deviceYield, revealSeconds, devErr = deviceFor(profile)
	if deviceYield == nil then
		return fail("INVALID_INPUT", devErr)
	end

	local next = deepCopy(profile)
	next.pendingPost = buildPendingPost(
		profile,
		"mission",
		contextId,
		templateId,
		fit,
		deviceYield,
		revealSeconds :: number,
		now,
		mission.runId,
		-- Mission-tagged posts score against the mission's own requirement.
		missionDef.requiredImpact
	)
	next.nextPostSequence = profile.nextPostSequence + 1
	-- postCount advances with the PUBLISH transition, not settlement
	-- (docs/03: the count and the pending post are one atomic write).
	next.activeMission = deepCopy(mission)
	next.activeMission.postCount = mission.postCount + 1
	next.activeMission.status = "resolvingPost"
	return ok(next)
end


-- ===== Settle =====
-- Consumes the frozen result. Requires now >= settleAt. Credits organic Cuan
-- once, adds the bounded own-post summary, clears the pending post, and for
-- mission posts adds impact and moves the mission status. A second settlement
-- after the pending post is consumed pays nothing.
function MissionService.settle(profile: any, now: number): OperationResult
	if not isValidServerTime(now) then
		return fail("INVALID_INPUT", "now must be a finite nonnegative number")
	end
	local pending = profile.pendingPost
	if pending == nil then
		return fail("NO_PENDING_POST", "no pending post to settle")
	end
	if now < pending.settleAt then
		return fail("NOT_DUE", `post settles at {pending.settleAt}`)
	end

	local next = deepCopy(profile)
	-- Credit the FROZEN organic payout exactly once.
	local nextBalance = profile.balance + pending.organicCuan
	local nextLifetime = profile.lifetimeEarned + pending.organicCuan
	-- Frozen economy guard (docs/04): refuse rather than clamp, so the payout
	-- formula is untouched and no partial mutation can land.
	if nextBalance >= MAX_ECONOMIC_TOTAL or nextLifetime >= MAX_ECONOMIC_TOTAL then
		return fail(
			"LIMIT_REACHED",
			`settlement would reach the {MAX_ECONOMIC_TOTAL} economy limit`
		)
	end
	next.balance = nextBalance
	next.lifetimeEarned = nextLifetime
	-- Bounded own-post summary (newest first, capped at 10).
	local summary = {
		postId = pending.postId,
		mode = pending.mode,
		contextId = pending.contextId,
		templateId = pending.templateId,
		finalImpact = pending.finalImpact,
		organicCuan = pending.organicCuan,
		publishedAt = pending.publishedAt,
		missionRunId = pending.missionRunId,
	}
	-- Retained summaries are DEEP COPIED from the input. `deepCopy(profile)`
	-- above already produced a private copy of ownPosts, but rebuilding the
	-- array from the input's tables would alias the caller's summaries into the
	-- proposal, so any later in-place edit would write through into the input
	-- profile. The module boundary (never mutates its input profile) requires
	-- the proposal to own every nested table.
	local ownPosts: { any } = { summary }
	for _, existing in ipairs(profile.ownPosts) do
		if #ownPosts < MAX_OWN_POSTS then
			table.insert(ownPosts, deepCopy(existing))
		end
	end
	next.ownPosts = ownPosts
	-- Clear the single global pending slot.
	next.pendingPost = nil

	if pending.mode == "mission" then
		local mission = profile.activeMission
		if mission == nil or mission.runId ~= pending.missionRunId then
			return fail("RUN_MISMATCH", "pending mission post has no matching active mission")
		end
		local missionDef = findMission(mission.missionId)
		if missionDef == nil then
			return fail("UNKNOWN_MISSION", `unknown mission {mission.missionId}`)
		end
		local updated = deepCopy(mission)
		updated.accumulatedImpact = mission.accumulatedImpact + pending.finalImpact
		if updated.accumulatedImpact >= missionDef.requiredImpact then
			updated.status = "readyToClaim"
		else
			-- Impact still short: back to accepted so a second post is allowed.
			updated.status = "accepted"
		end
		next.activeMission = updated
	end
	return ok(next)
end

-- ===== ClaimMission =====
-- Requires the matching active mission to be readyToClaim. Awards the fixed
-- catalog reward exactly once, records the run in the bounded claimed window,
-- and leaves the player free to accept another eligible mission.
function MissionService.claim(profile: any, runId: string): OperationResult
	if not isNonEmptyString(runId) then
		return fail("INVALID_INPUT", "runId is required")
	end
	local mission = profile.activeMission
	if mission == nil then
		return fail("NO_ACTIVE_MISSION", "no active mission")
	end
	if mission.runId ~= runId then
		return fail("RUN_MISMATCH", "runId does not match the active mission")
	end
	if mission.status ~= "readyToClaim" then
		return fail("NOT_READY", `mission is {mission.status}, not readyToClaim`)
	end
	local missionDef = findMission(mission.missionId)
	if missionDef == nil then
		return fail("UNKNOWN_MISSION", `unknown mission {mission.missionId}`)
	end
	-- Guard against a double claim even if the run was already recorded.
	for _, claimed in ipairs(profile.claimedRunIdsWindow) do
		if claimed == runId then
			return fail("ALREADY_DONE", "this run was already claimed")
		end
	end

	local next = deepCopy(profile)
	local nextBalance = profile.balance + missionDef.reward
	local nextLifetime = profile.lifetimeEarned + missionDef.reward
	-- Frozen economy guard (docs/04): refuse rather than clamp, so the fixed
	-- catalog reward is untouched and no partial mutation can land.
	if nextBalance >= MAX_ECONOMIC_TOTAL or nextLifetime >= MAX_ECONOMIC_TOTAL then
		return fail(
			"LIMIT_REACHED",
			`claim would reach the {MAX_ECONOMIC_TOTAL} economy limit`
		)
	end
	next.balance = nextBalance
	next.lifetimeEarned = nextLifetime
	next.completedMissions = profile.completedMissions + 1
	-- Bounded claimed-run window (<=32, newest last).
	local window: { string } = {}
	for _, claimed in ipairs(profile.claimedRunIdsWindow) do
		table.insert(window, claimed)
	end
	table.insert(window, runId)
	while #window > MAX_CLAIMED_RUNS do
		table.remove(window, 1)
	end
	next.claimedRunIdsWindow = window
	-- The mission is consumed; the player may accept another eligible one.
	next.activeMission = nil
	return ok(next)
end

MissionService.MAX_OWN_POSTS = MAX_OWN_POSTS
MissionService.MAX_CLAIMED_RUNS = MAX_CLAIMED_RUNS
MissionService.MAX_CAMPAIGN_POSTS = MAX_CAMPAIGN_POSTS

function MissionService.nextOrganicContext(profile: any): (any?, string?)
	return nextOrganicContext(profile)
end

return MissionService
]]></ProtectedString>
				<string name="ScriptGuid">{9A2F256B-CC1D-4CEB-B968-6E631AAF5FC2}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">MissionService</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">3e291f8efda2677b0b00df930000043b</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="94">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Catalog"))

local NetRouter = {}
NetRouter.__index = NetRouter

local CACHE_LIMIT = 64
local IDLE_SECONDS = 600
local WIRE_CODES = {
	OK = true, INVALID_INPUT = true, UNKNOWN_ACTION = true, SESSION_EXPIRED = true,
	LOCKED = true, BUSY = true, SAVE_UNAVAILABLE = true, NOT_READY = true,
	OUT_OF_RANGE = true, INSUFFICIENT_FUNDS = true, ALREADY_DONE = true, LIMIT_REACHED = true,
}
-- Frozen ReplyCode translation: unknown identifiers/mismatched runs are invalid
-- input; occupied/pending domain state is not ready; invalid authored content
-- is unavailable. Unknown internal codes fail closed and are reported locally.
local DOMAIN_CODES = {
	UNKNOWN_MISSION = "INVALID_INPUT", UNKNOWN_TEMPLATE = "INVALID_INPUT",
	UNKNOWN_CONTEXT = "INVALID_INPUT", RUN_MISMATCH = "INVALID_INPUT",
	UNKNOWN_DEVICE = "INVALID_INPUT", UNKNOWN_DESK = "INVALID_INPUT", UNKNOWN_WORKER = "INVALID_INPUT",
	NO_ACTIVE_MISSION = "NOT_READY", MISSION_ACTIVE = "NOT_READY", PENDING_POST = "NOT_READY",
	NOT_DUE = "NOT_READY", NO_PENDING_POST = "NOT_READY", INVALID_CONTENT = "SAVE_UNAVAILABLE",
}
local FIELDS = {
	GetSnapshot = { lookupRequestId = true }, AcceptMission = { missionId = true },
	PublishOrganic = { templateId = true }, PublishPost = { runId = true, templateId = true },
	ClaimMission = { runId = true }, BuyDevice = { deviceId = true }, BuyDesk = { slotIndex = true },
	HireWorker = { slotIndex = true, roleId = true }, CloseComputer = {},
}
local FIELD_COUNTS = {
	GetSnapshot = 1, AcceptMission = 1, PublishOrganic = 1, PublishPost = 2,
	ClaimMission = 1, BuyDevice = 1, BuyDesk = 1, HireWorker = 2, CloseComputer = 0,
}
local ENVELOPE_FIELDS = { requestId = true, action = true, payload = true, dashboardSessionId = true }
local missions: { [string]: boolean } = {}
local devices: { [string]: boolean } = {}
local organicTemplates: { [string]: boolean } = {}
local missionTemplates: { [string]: boolean } = {}
for _, mission in ipairs(Catalog.Missions) do
	missions[mission.missionId] = true
	for _, id in ipairs(mission.templates) do missionTemplates[id] = true end
end
for _, device in ipairs(Catalog.Devices) do devices[device.id] = true end
for _, context in ipairs(Catalog.OrganicContexts) do
	for _, id in ipairs(context.templates) do organicTemplates[id] = true end
end

local function wireCode(code: string): string
	if WIRE_CODES[code] then return code end
	if DOMAIN_CODES[code] then return DOMAIN_CODES[code] end
	warn(`NetRouter: unexpected result code {tostring(code)}`)
	return "SAVE_UNAVAILABLE"
end

local function ascii(value: any, minimum: number, maximum: number): boolean
	return typeof(value) == "string" and #value >= minimum and #value <= maximum
		and string.find(value, "[^%z\1-\127]") == nil
end
local function requestId(value: any): boolean
	return ascii(value, 8, 64)
end

-- Count only the bounded outer dictionaries. Values are checked as scalars
-- below, so cycles/deep client graphs never enter a recursive traversal.
local function exact(value: any, allowed: any, maximum: number): (boolean, number)
	if typeof(value) ~= "table" or getmetatable(value) ~= nil then return false, 0 end
	local count = 0
	for key in next, value do
		count += 1
		if count > maximum or typeof(key) ~= "string" or not allowed[key] then return false, count end
	end
	return true, count
end

local function validate(envelope: any): (any?, string)
	local shape = exact(envelope, ENVELOPE_FIELDS, 4)
	if not shape or not requestId(rawget(envelope, "requestId")) then return nil, "INVALID_INPUT" end
	local action = rawget(envelope, "action")
	if not ascii(action, 1, 32) then return nil, "INVALID_INPUT" end
	local fields = FIELDS[action]
	if fields == nil then return nil, "UNKNOWN_ACTION" end
	local payload = rawget(envelope, "payload")
	local payloadOk, count = exact(payload, fields, FIELD_COUNTS[action])
	if not payloadOk then return nil, "INVALID_INPUT" end
	local sessionId = rawget(envelope, "dashboardSessionId")
	if action == "GetSnapshot" then
		if sessionId ~= nil then return nil, "INVALID_INPUT" end
		local lookup = rawget(payload, "lookupRequestId")
		if lookup ~= nil and (not requestId(lookup) or lookup == envelope.requestId) then return nil, "INVALID_INPUT" end
	elseif not ascii(sessionId, 1, 64) or count ~= FIELD_COUNTS[action] then
		return nil, "INVALID_INPUT"
	end
	if action == "AcceptMission" and (not ascii(payload.missionId, 1, 64) or not missions[payload.missionId]) then
		return nil, "INVALID_INPUT"
	elseif action == "BuyDevice" and (not ascii(payload.deviceId, 1, 64) or not devices[payload.deviceId]) then
		return nil, "INVALID_INPUT"
	elseif action == "PublishOrganic" and (not ascii(payload.templateId, 1, 64) or not organicTemplates[payload.templateId]) then
		return nil, "INVALID_INPUT"
	elseif action == "PublishPost" and (not ascii(payload.templateId, 1, 64) or not missionTemplates[payload.templateId]) then
		return nil, "INVALID_INPUT"
	end
	if (action == "PublishPost" or action == "ClaimMission") and not ascii(payload.runId, 1, 64) then
		return nil, "INVALID_INPUT"
	end
	if (action == "BuyDesk" or action == "HireWorker") and payload.slotIndex ~= 1 and payload.slotIndex ~= 2 then
		return nil, "INVALID_INPUT"
	end
	if action == "HireWorker" and payload.roleId ~= "trainee" then return nil, "INVALID_INPUT" end
	local copy = {}
	for key, value in next, payload do copy[key] = value end
	return { requestId = envelope.requestId, action = action, payload = copy, dashboardSessionId = sessionId }, "OK"
end

local function sameIntent(entry: any, command: any): boolean
	if entry.action ~= command.action then return false end
	for field in pairs(FIELDS[command.action]) do
		if entry.payload[field] ~= command.payload[field] then return false end
	end
	return true
end

local function alive(player: any): boolean
	local character = player.Character
	if typeof(character) ~= "Instance" or not character:IsA("Model") then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	return humanoid ~= nil and humanoid.Health > 0 and root ~= nil and root:IsA("BasePart")
end

local function resultData(data: any): any?
	-- Session mutation results expose only bounded durable result identifiers.
	if typeof(data) ~= "table" or typeof(data.resultIds) ~= "table" then return nil end
	local ids = {}
	for index = 1, math.min(#data.resultIds, 8) do
		local id = data.resultIds[index]
		if typeof(id) == "string" and #id <= 128 then table.insert(ids, id) end
	end
	return { resultIds = ids }
end

function NetRouter.EnsureRemotes(storage: Instance): any
	local folder: Instance? = nil
	for _, child in ipairs(storage:GetChildren()) do
		if child.Name == "BuzzerRemotes" then
			assert(folder == nil and child:IsA("Folder"), "NetRouter: conflicting BuzzerRemotes")
			folder = child
		end
	end
	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = "BuzzerRemotes"
		folder.Parent = storage
	end
	local remotes: any = {}
	for _, child in ipairs(folder:GetChildren()) do
		assert((child.Name == "Command" or child.Name == "Reply" or child.Name == "Snapshot")
			and child:IsA("RemoteEvent") and remotes[child.Name] == nil, "NetRouter: conflicting remote child")
		remotes[child.Name] = child
	end
	for _, name in ipairs({ "Command", "Reply", "Snapshot" }) do
		if remotes[name] == nil then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
			remotes[name] = remote
		end
	end
	return remotes
end

function NetRouter.new(options: any): any
	assert(options.world and options.sendReply and options.sendSnapshot, "NetRouter: world and private transports required")
	return setmetatable({
		_world = options.world, _now = options.now or os.time, _monotonic = options.monotonic or os.clock,
		_guid = options.guid or function() return HttpService:GenerateGUID(false) end,
		_sendReply = options.sendReply, _sendSnapshot = options.sendSnapshot,
		_onConfirmed = options.onConfirmed, _beforeMutation = options.beforeMutation,
		_records = {}, _destroyed = false,
	}, NetRouter)
end

function NetRouter:Register(player: any, session: any)
	assert(not self._destroyed, "NetRouter: destroyed")
	self._records[player] = {
		session = session, dashboard = nil, cache = {}, order = {},
		windowStart = self._monotonic(), count = 0, lastPublish = -math.huge, lastPush = -math.huge,
	}
end

function NetRouter:Unregister(player: any)
	self._records[player] = nil
end

function NetRouter:_send(player: any, record: any, callback: any, message: any): boolean
	if self._records[player] ~= record then return false end
	local ok, err = pcall(callback, player, message)
	if not ok then warn(`NetRouter transport: {tostring(err)}`) end
	return ok
end

function NetRouter:_expire(player: any, record: any, reason: string)
	local dashboard = record.dashboard
	if dashboard == nil then return end
	record.dashboard = nil
	self:_send(player, record, self._sendSnapshot, {
		kind = "ComputerSessionExpired", dashboardSessionId = dashboard.id, reason = reason,
	})
end

function NetRouter:_current(player: any, record: any)
	if record.dashboard == nil then return end
	if not alive(player) or player.Character ~= record.dashboard.character then
		self:_expire(player, record, "CHARACTER_LOST")
	elseif self._monotonic() >= record.dashboard.deadline then
		self:_expire(player, record, "IDLE")
	end
end

function NetRouter:_reply(player: any, record: any, id: string, result: any, data: any?): boolean
	if self._records[player] ~= record then return false end
	self:_current(player, record)
	local read = record.session:ReadSnapshot()
	local dashboard = record.dashboard
	return self:_send(player, record, self._sendReply, {
		requestId = id, ok = result.ok, code = wireCode(result.code),
		revision = result.revision or (if read.snapshot then read.snapshot.revision else 0), serverTime = self._now(),
		dashboardSession = if dashboard then { dashboardSessionId = dashboard.id, expiresAt = dashboard.expiresAt } else nil,
		data = data,
	})
end

function NetRouter:_remember(record: any, command: any): any?
	while #record.order >= CACHE_LIMIT do
		local index = nil
		for i, id in ipairs(record.order) do
			if not record.cache[id].pending then index = i break end
		end
		if index == nil then return nil end
		local id = table.remove(record.order, index)
		record.cache[id] = nil
	end
	local entry = { action = command.action, payload = command.payload, pending = true }
	record.cache[command.requestId] = entry
	table.insert(record.order, command.requestId)
	return entry
end

function NetRouter:_lookup(record: any, id: string, lookup: any): any
	-- A confirmed session result always outranks the router's older local state.
	if lookup ~= nil and lookup.status == "APPLIED" then
		local original = lookup.originalResult
		return { originalRequestId = id, status = "APPLIED", originalResult = {
			ok = true, code = "OK", revision = original.revision, data = resultData(original.data),
		} }
	end
	local entry = record.cache[id]
	if entry ~= nil and entry.action ~= "GetSnapshot" and entry.action ~= "CloseComputer" then
		if entry.pending then return { originalRequestId = id, status = "PENDING" } end
		if entry.result ~= nil then
			return { originalRequestId = id, status = if entry.result.ok then "APPLIED" else "REJECTED", originalResult = {
				ok = entry.result.ok, code = wireCode(entry.result.code), revision = entry.result.revision,
				data = resultData(entry.result.data),
			} }
		end
	end
	if lookup ~= nil and lookup.status == "REJECTED" then
		return { originalRequestId = id, status = "REJECTED", originalResult = {
			ok = false, code = wireCode(lookup.originalResult.code), revision = lookup.originalResult.revision,
			data = resultData(lookup.originalResult.data),
		} }
	end
	return { originalRequestId = id, status = if lookup and lookup.status == "PENDING" then "PENDING" else "UNKNOWN" }
end

function NetRouter:HandleCommand(player: any, envelope: any): boolean
	local record = self._records[player]
	if record == nil then return false end
	self:_current(player, record)
	local now = self._monotonic()
	if now - record.windowStart >= 1 then record.windowStart, record.count = now, 0 end
	record.count = math.min(record.count + 1, 9)
	local id = if typeof(envelope) == "table" then rawget(envelope, "requestId") else nil
	if not requestId(id) then return false end
	if record.count > 8 then return self:_reply(player, record, id, { ok = false, code = "BUSY" }) end
	local command, code = validate(envelope)
	if command == nil then return self:_reply(player, record, id, { ok = false, code = code }) end
	local action = command.action
	local entry = record.cache[id]
	if entry ~= nil and not sameIntent(entry, command) then
		return self:_reply(player, record, id, { ok = false, code = "INVALID_INPUT" })
	end
	if action == "GetSnapshot" then
		local own = record.session:ReadSnapshot(id)
		if entry == nil and own.lookup ~= nil and own.lookup.status ~= "UNKNOWN" then
			return self:_reply(player, record, id, { ok = false, code = "INVALID_INPUT" })
		end
		if entry == nil then
			entry = self:_remember(record, command)
			if entry == nil then return self:_reply(player, record, id, { ok = false, code = "BUSY" }) end
		end
		local read = record.session:Snapshot(command.payload.lookupRequestId)
		entry.pending = false
		if self._records[player] ~= record then return false end
		if not read.ok or read.snapshot == nil then return self:_reply(player, record, id, read) end
		local lookup = if command.payload.lookupRequestId then self:_lookup(record, command.payload.lookupRequestId, read.lookup) else nil
		return self:_reply(player, record, id, read, { snapshot = read.snapshot, lookup = lookup })
	end
	if action ~= "CloseComputer" then
		local loaded = record.session:ReadSnapshot()
		if not loaded.ok or loaded.snapshot == nil then
			return self:_reply(player, record, id, { ok = false, code = "NOT_READY" })
		end
		-- The session's authoritative encoder also bounds escaped ASCII. Check
		-- before idle admission; never forward the computed intent to Mutate.
		local encodable = pcall(record.session._canonicalIntent, action, command.payload)
		if not encodable then
			return self:_reply(player, record, id, { ok = false, code = "INVALID_INPUT" })
		end
	end
	local dashboard = record.dashboard
	if dashboard == nil or dashboard.id ~= command.dashboardSessionId then
		return self:_reply(player, record, id, { ok = false, code = "SESSION_EXPIRED" })
	end
	if action == "CloseComputer" then
		if entry == nil then
			local prior = record.session:ReadSnapshot(id)
			if prior.lookup ~= nil and prior.lookup.status ~= "UNKNOWN" then
				return self:_reply(player, record, id, { ok = false, code = "INVALID_INPUT" })
			end
			entry = self:_remember(record, command)
			if entry == nil then return self:_reply(player, record, id, { ok = false, code = "BUSY" }) end
		end
		entry.pending = false
		record.dashboard = nil
		return self:_reply(player, record, id, { ok = true, code = "OK" })
	end
	if entry ~= nil and entry.pending then return self:_reply(player, record, id, { ok = false, code = "BUSY" }) end
	local prior = record.session:ReadSnapshot(id)
	if entry ~= nil and entry.result ~= nil
		and (entry.result.ok or prior.lookup == nil or prior.lookup.status ~= "APPLIED") then
		return self:_reply(player, record, id, entry.result, resultData(entry.result.data))
	end
	local recovery = entry ~= nil or (prior.lookup ~= nil and prior.lookup.status ~= "UNKNOWN")
	if not recovery then
		local writable, denied = record.session:IsWritable()
		if not writable then return self:_reply(player, record, id, { ok = false, code = denied or "NOT_READY" }) end
		if (action == "PublishOrganic" or action == "PublishPost") and now - record.lastPublish < 2 then
			return self:_reply(player, record, id, { ok = false, code = "BUSY" })
		end
	end
	entry = entry or self:_remember(record, command)
	if entry == nil then return self:_reply(player, record, id, { ok = false, code = "BUSY" }) end
	entry.pending = true
	if not recovery then
		dashboard.deadline = now + IDLE_SECONDS
		dashboard.expiresAt = self._now() + IDLE_SECONDS
		if action == "PublishOrganic" or action == "PublishPost" then record.lastPublish = now end
	end
	-- No yielding operation may occur between admission and reservation. Runtime's
	-- hook captures connected time without writing; domain owns its only write lane.
	local ok, result = pcall(function(): { ok: boolean, code: string, revision: number?, data: any?, lookup: string? }
		if self._beforeMutation ~= nil then self._beforeMutation(player) end
		if self._records[player] ~= record then return { ok = false, code = "LOCKED" } end
		return record.session:Mutate({ requestId = id, action = action, payload = command.payload })
	end)
	entry.pending = false
	if not ok then error(result, 0) end
	if result.ok or result.lookup == "REJECTED" then entry.result = result end
	if self._records[player] ~= record then return false end
	if result.ok then
		local read = record.session:ReadSnapshot()
		if self._onConfirmed ~= nil then
			local synced, err = pcall(self._onConfirmed, player, read.snapshot)
			if not synced then warn(`NetRouter confirmed presentation: {tostring(err)}`) end
		end
		self:_send(player, record, self._sendSnapshot, { kind = "State", state = read.snapshot })
	end
	return self:_reply(player, record, id, result, resultData(result.data))
end

function NetRouter:HandlePrompt(prompt: any, player: any): boolean
	local record = self._records[player]
	if record == nil then return false end
	self:_current(player, record)
	local send = self._send :: typeof(NetRouter._send)
	local function deny(code: string): boolean
		send(self, player, record, self._sendSnapshot, { kind = "OpenComputerDenied", code = code })
		return false
	end
	local read = record.session:ReadSnapshot()
	if not read.ok or read.snapshot == nil then return deny("NOT_READY") end
	local writable, code = record.session:IsWritable()
	if not writable then return deny(if code == "SAVE_UNAVAILABLE" then "SAVE_UNAVAILABLE" else "NOT_READY") end
	if not alive(player) then return deny("INVALID_STATE") end
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") then return deny("INVALID_STATE") end
	local ok, valid, detail = pcall(function()
		if self._world.GetPrompt(player) ~= prompt then return false, "identity" end
		return self._world.ValidateDashboardPrompt(player, prompt)
	end)
	if not ok then
		warn(`NetRouter prompt world: {tostring(valid)}`)
		return deny("INVALID_STATE")
	end
	if not valid then
		return deny(if typeof(detail) == "string" and string.find(detail, "studs", 1, true) then "OUT_OF_RANGE" else "INVALID_STATE")
	end
	if self._records[player] ~= record then return false end
	local id = self._guid()
	assert(ascii(id, 1, 64), "NetRouter: invalid generated dashboard ID")
	local expiresAt = self._now() + IDLE_SECONDS
	record.dashboard = { id = id, expiresAt = expiresAt, deadline = self._monotonic() + IDLE_SECONDS, character = player.Character }
	return send(self, player, record, self._sendSnapshot, {
		kind = "OpenComputer", dashboardSessionId = id, expiresAt = expiresAt, serverTime = self._now(), state = read.snapshot,
	})
end

function NetRouter:CharacterLost(player: any)
	local record = self._records[player]
	if record ~= nil then self:_expire(player, record, "CHARACTER_LOST") end
end

function NetRouter:Step()
	for player, record in pairs(self._records) do self:_current(player, record) end
end

function NetRouter:PushState(player: any): boolean
	local record = self._records[player]
	if record == nil or self._monotonic() - record.lastPush < 2 then return false end
	local read = record.session:ReadSnapshot()
	if not read.ok or read.snapshot == nil then return false end
	record.lastPush = self._monotonic()
	return self:_send(player, record, self._sendSnapshot, { kind = "State", state = read.snapshot })
end

function NetRouter:Destroy()
	self._destroyed = true
	table.clear(self._records)
end

return NetRouter
]]></ProtectedString>
				<string name="ScriptGuid">{00930AAB-801F-4A4E-8AD4-E0DB9FDDE6BE}</string>
